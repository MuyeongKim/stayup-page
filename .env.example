# GitHub OAuth App에서 발급받은 값입니다. 실제 비밀값은 Vercel에만 저장하세요.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub OAuth App의 Authorization callback URL과 정확히 같아야 합니다.
GITHUB_OAUTH_CALLBACK_URL=https://www.stayup-ai.com/api/callback

# 최소 32자. `openssl rand -hex 32`로 생성할 수 있습니다.
OAUTH_STATE_SECRET=

# 관리 화면을 열 수 있는 exact origin 목록입니다. 필요한 Preview URL도 개별 추가하세요.
OAUTH_ALLOWED_ORIGINS=https://stayup-ai.com,https://www.stayup-ai.com,https://stayup-page.vercel.app

# 공개 저장소는 public_repo, 비공개 저장소는 repo를 사용합니다.
GITHUB_OAUTH_SCOPE=public_repo
GITHUB_OAUTH_REPOSITORY=MuyeongKim/stayup-page

# Vercel의 Upstash Redis 연결 시 자동 주입됩니다. 실제 값은 저장소에 커밋하지 마세요.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 익명 방문 식별자를 HMAC 처리하는 32자 이상의 비밀값입니다.
VISITOR_COOKIE_SECRET=
